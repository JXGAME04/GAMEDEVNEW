-- [KM 28/08] Boss "Ke Trom Chan Nguyen" - port ban Linux (global\thinh\npc\add_npc.lua:
-- 13 con map 53, AddNpcEx cap 95 + SetNpcDeathScript rskinhmach\npcdeath.lua).
-- JX1: template 1362 (Hac Y Sat Thu, npcs.txt co that), toa do theo dai da chung minh
-- boi 20 boss Sat Thu co san cung map (1590-1625 x 3180-3250). Duoc goi tu startgame.lua.

tbKeTromCN = {
	{0, 1592, 3185}, {1, 1600, 3190}, {2, 1608, 3195}, {4, 1616, 3200},
	{3, 1624, 3205}, {4, 1594, 3212}, {0, 1602, 3218}, {2, 1610, 3224},
	{4, 1618, 3230}, {0, 1596, 3236}, {1, 1604, 3242}, {1, 1612, 3248},
	{1, 1620, 3182},
}

function KM_AddKeTrom()
	local nMid = SubWorldID2Idx(53)
	if nMid < 0 then
		return 0
	end
	local nSo = 0
	local i = 1
	while i <= getn(tbKeTromCN) do
		local t = tbKeTromCN[i]
		local nIdx = AddNpcEx(1362, 95, t[1], nMid, t[2] * 32, t[3] * 32, 0, "KÎ Trém Ch©n Nguyªn "..i)
		if nIdx > 0 then
			SetNpcDeathScript(nIdx, "\\script\\global\\thanh\\npc\\kinhmach_ketrom_death.lua")
			nSo = nSo + 1
		end
		i = i + 1
	end
	return nSo
end
