<?xml version="1.0" encoding="UTF-8"?>
<!-- [IOS 11/09] Ban ke cua ung dung. CMake xu ly tep nay bang configure_file (thay @BIEN@), Xcode thay $(BIEN) sau do.
     [IOS-PHATHANH 16/09] Cac khoa THO (chia se tep qua Finder, HTTP trong LAN) chi con khi JX_IOS_KHOA_NOI_BO=ON,
     xem ios/CMakeLists.txt; ban App Store khong co chung. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>              <string>vi</string>
	<key>CFBundleExecutable</key>                     <string>jx1ios</string>
	<key>CFBundleIdentifier</key>                     <string>vn.jx1.mobile</string>
	<key>CFBundleInfoDictionaryVersion</key>          <string>6.0</string>
	<key>CFBundleName</key>                           <string>JX1 Mobile</string>
	<key>CFBundleDisplayName</key>                    <string>JX1 Mobile</string>
	<key>CFBundlePackageType</key>                    <string>APPL</string>
	<key>CFBundleShortVersionString</key>             <string>1.0</string>
	<!-- [IOS-PHATHANH 15/09] So ban dung: App Store Connect tu choi ban tai len co CFBundleVersion trung ban truoc.
	     Xcode thay $(CURRENT_PROJECT_VERSION) bang gia tri dat trong ios/CMakeLists.txt (JX_IOS_SO_BAN_DUNG). -->
	<key>CFBundleVersion</key>                        <string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>                     <true/>
	<!-- [IOS-PHATHANH 15/09] CFBundleIconName cap cao nhat: thieu la App Store Connect tu choi ban tai len
	     (ITMS-90713). actool chi ghi khoa nay LONG trong CFBundleIcons, va du an khong bat GENERATE_INFOPLIST_FILE
	     nen khong co ai them ho. Gia tri phai trung ten bo icon trong ios/Assets.xcassets (AppIcon). -->
	<key>CFBundleIconName</key>                       <string>AppIcon</string>
	<key>MinimumOSVersion</key>                       <string>15.0</string>
	<!-- [IOS-PHATHANH 16/09] Khoa THO, ios/CMakeLists.txt dien khi JX_IOS_KHOA_NOI_BO=ON: UIFileSharingEnabled,
	     LSSupportsOpeningDocumentsInPlace, NSAllowsLocalNetworking, NSLocalNetworkUsageDescription. OFF = dong trong. -->
	@JX_IOS_PLIST_NOI_BO@
	<!-- [IOS-PHATHANH 16/09] Dia chi kho du lieu ghi san (bien CMake JX_IOS_KHO_DU_LIEU, da escape XML). Rong = chua co
	     may chu; may cai moi se khong khoi dong duoc - script phat hanh tu choi dong goi khi rong. -->
	<key>JxKhoDuLieu</key>                            <string>@JX_IOS_KHO_XML@</string>
	<key>UIRequiresFullScreen</key>                   <true/>
	<key>UIStatusBarHidden</key>                      <true/>
	<key>UIViewControllerBasedStatusBarAppearance</key> <false/>
	<key>UILaunchScreen</key>                         <dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
</dict>
</plist>
