/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_STARTSERVER         ICON    DISCARDABLE     "StartServer.ICO"
IDI_SMALL               ICON    DISCARDABLE     "SMALL.ICO"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_STARTSERVER MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...",                  IDM_ABOUT
    END
    POPUP "Start"
    BEGIN
        MENUITEM "1.Sword3PaySys",              IDM_START_1
        MENUITEM "2.S3RelayServer",             IDM_START_2
        MENUITEM "3.Goddess",                   IDM_START_3
        MENUITEM "4.Bishop",                    IDM_START_4
        MENUITEM "5.S3Relay",                   IDM_START_5
        MENUITEM "6.GameServer",                IDM_START_6
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_STARTSERVER ACCELERATORS MOVEABLE PURE 
BEGIN
    "/",            IDM_ABOUT,              ASCII,  ALT, NOINVERT
    "?",            IDM_ABOUT,              ASCII,  ALT, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  22, 17, 230, 75
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "System"
BEGIN
    ICON            IDI_STARTSERVER,IDC_MYICON,14,9,16,16
    LTEXT           "StartServer Version 1.0",IDC_STATIC2,49,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2021",IDC_STATIC2,49,20,119,8
    DEFPUSHBUTTON   "OK",IDOK,195,6,30,11,WS_GROUP
END


