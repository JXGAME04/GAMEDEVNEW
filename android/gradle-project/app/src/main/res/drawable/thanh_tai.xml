<?xml version="1.0" encoding="utf-8"?>
<!-- [ANDROID 12/09 TAI] ong tien do: rang toi vien vang, phan da tai chuyen sac vang -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#1A120A" />
            <stroke android:width="1dp" android:color="#8C6A32" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="4dp" />
                <gradient android:startColor="#F5D68A" android:centerColor="#D9A94A" android:endColor="#A8761E" android:angle="270" />
            </shape>
        </clip>
    </item>
</layer-list>
